{
  "name": "opengalaxy",
  "private": true,
  "version": "0.2.0",
  "description": "Lightweight, open-source WebHID lighting controller for the Epomaker Galaxy80 keyboard.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "decode": "node tools/decode-usbpcap.mjs",
    "export": "npm run build && node tools/export.mjs",
    "desktop": "node tools/build-desktop.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
